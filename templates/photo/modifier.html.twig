{% extends 'base.html.twig' %}

{% block title %}Modifier une photo{% endblock %}

{% block body %}
    <h1>Modifier une photo</h1>
    <img src="{{ asset('Photos/' ~ photo.nomFichier) }}" alt="" class="img-thumbnail mb-3" style="max-height: 200px;">
    <p class="text-muted">Laissez le champ image vide pour garder l'image actuelle.</p>
    {{ form(formulaire) }}
    <a href="{{ path("app_photos") }}" class="btn btn-secondary mt-3">&lt; Retour aux photos</a>
{% endblock %}
