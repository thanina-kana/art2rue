{% extends 'base.html.twig' %}

{% block title %}Supprimer un artiste{% endblock %}

{% block body %}
    <h1>Supprimer un artiste</h1>
    <h2>Êtes-vous sûr(e) de vouloir supprimer {{ artiste.pseudo }} ?</h2>
    {% if artiste.oeuvres|length > 0 %}
        <p class="alert alert-warning">
            Ses {{ artiste.oeuvres|length }} œuvre(s) resteront dans l'archive, mais ne lui seront plus attribuées.
        </p>
    {% endif %}
    {{ form(formulaire) }}
    <a href="{{ path("app_artistes") }}" class="btn btn-secondary mt-3">&lt; Retour à la liste des artistes</a>
{% endblock %}
