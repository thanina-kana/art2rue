{% extends 'base.html.twig' %}

{% block title %}Les lieux{% endblock %}

{% block body %}
    <h1>Les lieux</h1>
    <table class="table table-striped">
        <tr>
            <th>Nom</th>
            <th>Adresse</th>
            <th>Quartier</th>
            <th>GPS</th>
            {% if app.user %}<th>Actions</th>{% endif %}
        </tr>
        {% for lieu in lieux %}
            <tr>
                <td>{{ lieu.nom }}</td>
                <td>{{ lieu.adresse ?? '—' }}</td>
                <td>{{ lieu.quartier }}</td>
                <td>{{ lieu.latitude }}, {{ lieu.longitude }}</td>
                {% if app.user %}
                    <td>
                        <a class="btn btn-warning" href="{{ path("app_modifier_lieu", {"id": lieu.id}) }}">Modifier</a>
                        <a class="btn btn-danger" href="{{ path("app_supprimer_lieu", {"id": lieu.id}) }}">Supprimer</a>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun lieu pour le moment.</td></tr>
        {% endfor %}
    </table>
    {% if app.user %}
        <a class="btn btn-primary" href="{{ path("app_ajouter_lieu") }}">Ajouter un lieu</a>
    {% endif %}
{% endblock %}
